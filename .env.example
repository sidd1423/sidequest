# Copy this file to .env and adjust as needed (.env is git-ignored)

# Where the Streamlit app sends preferences
BACKEND_URL=http://localhost:8000

# SQLite file the backend stores preferences and quests in
DATABASE_PATH=sidequest.db

# --- Gemma inference API (any OpenAI-compatible /chat/completions endpoint) ---
# Google AI Studio (default) - get a free key at https://aistudio.google.com/apikey
GEMMA_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMMA_API_KEY=
GEMMA_MODEL=gemma-4-26b-a4b-it

# Ollama instead (run `ollama pull gemma3` first; no key needed):
# GEMMA_BASE_URL=http://localhost:11434/v1
# GEMMA_MODEL=gemma3

# Seconds to wait for the model per attempt
GEMMA_TIMEOUT=90

# Max tokens per answer (Gemma 4 spends some on thinking before the JSON)
GEMMA_MAX_TOKENS=8192

# --- Example-quest library ---
# Local SQLite library (default, works offline). Re-seed: python -m backend.library
LIBRARY_PATH=data/quest_library.db

# Tiger Data instead (optional) - when set, this takes priority over the local library.
# Service URL from the Tiger console, e.g.
# postgres://tsdbadmin:<password>@<service-id>.<project-id>.tsdb.cloud.timescale.com:<port>/tsdb?sslmode=require
# Leave empty to use the local library above.
TIGER_DATABASE_URL=
TIGER_QUESTS_TABLE=quests

# Embeddings for retrieval (defaults to your GEMMA_API_KEY / Google AI Studio)
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768
# EMBEDDING_API_KEY=
